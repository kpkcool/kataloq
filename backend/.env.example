# kataloq-api configuration.
# Copy to backend/.env to override defaults for `npm run dev`.
# Every variable is optional: the values below are the defaults.
# Never commit a real .env file or real credentials.

# --- Server ---
PORT=3000
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Product data source (Fake Store API) ---
FAKE_STORE_BASE_URL=https://fakestoreapi.com
# Upstream request timeout in milliseconds (100–30000)
UPSTREAM_TIMEOUT_MS=5000
# In-memory product cache lifetime in seconds. 0 disables the cache.
PRODUCT_CACHE_TTL_SECONDS=60

# --- Catalogue rules ---
# Exactly 5 unique product IDs, shown on Home in this order.
# Default covers all four Fake Store categories.
FEATURED_PRODUCT_IDS=1,5,9,14,18
# Number of products in a category's "Top Rated" section (1–20)
CATEGORY_TOP_RATED_COUNT=3

# --- Email (SMTP) ---
# Local default points at Mailpit (docker compose sets SMTP_HOST=mailpit).
SMTP_HOST=localhost
SMTP_PORT=1025
# true for implicit TLS (port 465); false for plain/STARTTLS
SMTP_SECURE=false
# Only needed for a real SMTP relay. Leave empty for Mailpit.
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Kataloq <no-reply@kataloq.local>
SALES_INBOX_EMAIL=sales@kataloq.local

# --- Abuse protection ---
# Max enquiry submissions per client IP per minute
ENQUIRY_RATE_LIMIT_PER_MINUTE=5
